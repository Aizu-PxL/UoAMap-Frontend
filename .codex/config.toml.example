# Inert repository-local Codex configuration example.
# Review and copy to .codex/config.toml manually if these defaults are desired.
# Codex loads project configuration only when the project is trusted.

model = "gpt-5.6"
model_reasoning_effort = "high"
plan_mode_reasoning_effort = "xhigh"
model_verbosity = "medium"
review_model = "gpt-5.6"

approval_policy = "on-request"
sandbox_mode = "workspace-write"

[sandbox_workspace_write]
network_access = false
writable_roots = []
